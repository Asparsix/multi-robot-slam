Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /robot1/map
        Depth: 5
        Durability Policy: Transient Local
      Alpha: 0.7
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Enabled: true
      Topic:
        Value: /robot1/global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
      Alpha: 0.3
      Color Scheme: costmap
    - Class: rviz_default_plugins/LaserScan
      Name: Scan_robot1
      Enabled: true
      Topic:
        Value: /robot1/scan
        Depth: 5
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/LaserScan
      Name: Scan_robot2
      Enabled: true
      Topic:
        Value: /robot2/scan_viz
        Depth: 5
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 0; 255; 0
    - Class: rviz_default_plugins/LaserScan
      Name: Scan_robot3
      Enabled: true
      Topic:
        Value: /robot3/scan_viz
        Depth: 5
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 0; 128; 255
    - Class: rviz_default_plugins/LaserScan
      Name: Scan_robot4
      Enabled: true
      Topic:
        Value: /robot4/scan_viz
        Depth: 5
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 200; 0
    - Class: rviz_default_plugins/RobotModel
      Name: Robot1
      Enabled: true
      Description Topic:
        Value: /robot1/robot_description
      TF Prefix: ""
    - Class: rviz_default_plugins/RobotModel
      Name: Robot2
      Enabled: true
      Description Topic:
        Value: /robot2/robot_description
      TF Prefix: robot2
    - Class: rviz_default_plugins/RobotModel
      Name: Robot3
      Enabled: true
      Description Topic:
        Value: /robot3/robot_description
      TF Prefix: robot3
    - Class: rviz_default_plugins/RobotModel
      Name: Robot4
      Enabled: true
      Description Topic:
        Value: /robot4/robot_description
      TF Prefix: robot4
    - Class: rviz_default_plugins/Path
      Name: Plan_robot1
      Enabled: true
      Topic:
        Value: /robot1/plan
      Color: 25; 255; 0
    - Class: rviz_default_plugins/Path
      Name: Plan_robot2
      Enabled: true
      Topic:
        Value: /robot2/plan
      Color: 0; 255; 0
    - Class: rviz_default_plugins/Path
      Name: Plan_robot3
      Enabled: true
      Topic:
        Value: /robot3/plan
      Color: 0; 128; 255
    - Class: rviz_default_plugins/Path
      Name: Plan_robot4
      Enabled: true
      Topic:
        Value: /robot4/plan
      Color: 255; 200; 0
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap_robot4
      Enabled: true
      Topic:
        Value: /robot4/local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
      Alpha: 0.4
      Color Scheme: costmap
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    # Initial pose is set automatically from spawn (AMCL set_initial_pose +
    # static map->odom). These tools are optional overrides only.
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /robot1/initialpose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /robot2/initialpose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /robot3/initialpose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /robot4/initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /robot1/goal_pose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /robot2/goal_pose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /robot3/goal_pose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /robot4/goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Name: Current View
      Pitch: 1.0
      Yaw: 0.7
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 900
  Width: 1400
